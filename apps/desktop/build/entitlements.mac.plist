<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required for Electron/V8 JIT -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Required for Electron's runtime code generation -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Required for loading Node.js native modules without Apple-signed deps -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Outgoing TCP to Roon Server and incoming UDP for SOOD discovery -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
  </dict>
</plist>
